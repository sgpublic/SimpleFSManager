[Unit]
Description=SimpleFSManager disk management service
DefaultDependencies=no
After=systemd-udevd.service
Before=local-fs-pre.target local-fs.target

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
ExecStart=/usr/bin/simplefsmanager
Restart=on-failure
RestartSec=3
NoNewPrivileges=false
MountFlags=shared

[Install]
WantedBy=local-fs-pre.target
