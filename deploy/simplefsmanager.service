[Unit]
Description=SimpleFSManager disk management service
DefaultDependencies=no
After=systemd-udevd.service
Before=local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/simplefsmanager
Restart=on-failure
RestartSec=3
NoNewPrivileges=false
MountFlags=shared

[Install]
WantedBy=multi-user.target
