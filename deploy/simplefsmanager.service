[Unit]
Description=SimpleFSManager disk management service
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/simplefsmanager
Restart=on-failure
RestartSec=3
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
